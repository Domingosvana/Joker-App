<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/nav_home">


    <fragment
        android:id="@+id/nav_home"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home"
        android:name="com.kody.jokeapp.view.HomeFragment"
        >
        <action
            android:id="@+id/action_nav_home_to_nav_joke"
            app:destination="@id/nav_joke" />
    </fragment>


    <fragment
        android:id="@+id/nav_joke"

        tools:layout="@layout/fragment_joker"
        android:name="com.kody.jokeapp.view.JokeFragment"
        />




    <fragment
        android:id="@+id/nav_joke_day"
        android:label="@string/menu_joke_day"
        tools:layout="@layout/fragment_joke_day"
        android:name="com.kody.jokeapp.view.JokeDayFragment"
        />

    <fragment
        android:id="@+id/nav_about"
        android:label="@string/menu_about"
        tools:layout="@layout/fragment_about"
        android:name="com.kody.jokeapp.view.AboutFragment"
        />


</navigation>